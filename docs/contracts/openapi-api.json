{
  "components": {
    "schemas": {
      "AlertOut": {
        "description": "Alerte énergétique, miroir de l'alerte de l'API Mock IoT.",
        "properties": {
          "alert_id": {
            "description": "Identifiant technique de l'alerte.",
            "title": "Alert Id",
            "type": "string"
          },
          "message": {
            "description": "Description de l'alerte fournie par la source.",
            "title": "Message",
            "type": "string"
          },
          "severity": {
            "description": "Gravité de l'alerte.",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ],
            "title": "Severity",
            "type": "string"
          },
          "site_id": {
            "description": "Identifiant du site concerné par l'alerte.",
            "title": "Site Id",
            "type": "string"
          },
          "threshold": {
            "description": "Seuil dont le dépassement a déclenché l'alerte.",
            "title": "Threshold",
            "type": "number"
          },
          "timestamp": {
            "description": "Horodatage de déclenchement, ISO 8601 UTC.",
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "type": {
            "description": "Nature de l'anomalie détectée.",
            "enum": [
              "spike",
              "threshold",
              "anomaly",
              "outage",
              "sensor"
            ],
            "title": "Type",
            "type": "string"
          },
          "value": {
            "description": "Valeur mesurée ayant déclenché l'alerte.",
            "title": "Value",
            "type": "number"
          }
        },
        "required": [
          "alert_id",
          "timestamp",
          "site_id",
          "severity",
          "type",
          "message",
          "value",
          "threshold"
        ],
        "title": "AlertOut",
        "type": "object"
      },
      "Body_create_token_api_v1_auth_token_post": {
        "properties": {
          "client_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Id"
          },
          "client_secret": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "format": "password",
            "title": "Client Secret"
          },
          "grant_type": {
            "anyOf": [
              {
                "pattern": "^password$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grant Type"
          },
          "password": {
            "format": "password",
            "title": "Password",
            "type": "string"
          },
          "scope": {
            "default": "",
            "title": "Scope",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "Body_create_token_api_v1_auth_token_post",
        "type": "object"
      },
      "EnergyReadingOut": {
        "description": "Mesure énergétique horodatée.\n\nReprend tous les champs de l'EnergyReading source, complétés par les\ncolonnes d'imputation propres à notre base TimescaleDB.",
        "properties": {
          "consumption_kw": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Puissance instantanée mesurée en kilowatts, nulle si absente de la source.",
            "title": "Consumption Kw"
          },
          "consumption_kw_imputed": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Puissance imputée en kilowatts, calculée par l'ETL. Jamais confondue avec consumption_kw qui reste la valeur brute de la source.",
            "title": "Consumption Kw Imputed"
          },
          "consumption_kwh": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Énergie consommée sur le pas de temps en kilowattheures.",
            "title": "Consumption Kwh"
          },
          "current_a": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Intensité mesurée en ampères.",
            "title": "Current A"
          },
          "data_quality": {
            "description": "Qualité de la mesure telle que qualifiée par la source.",
            "enum": [
              "good",
              "partial",
              "degraded",
              "critical"
            ],
            "title": "Data Quality",
            "type": "string"
          },
          "humidity_percent": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Humidité relative relevée en pourcentage.",
            "title": "Humidity Percent"
          },
          "imputation_method": {
            "description": "Méthode d'imputation appliquée : none si la mesure brute est exploitable, locf pour un report de la dernière valeur connue, interpolation sinon.",
            "enum": [
              "none",
              "locf",
              "interpolation"
            ],
            "title": "Imputation Method",
            "type": "string"
          },
          "null_reasons": {
            "description": "Motifs fournis par la source pour chaque champ absent de la mesure.",
            "items": {
              "type": "string"
            },
            "title": "Null Reasons",
            "type": "array"
          },
          "power_factor": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Facteur de puissance mesuré.",
            "title": "Power Factor"
          },
          "site_id": {
            "description": "Identifiant du site auquel la mesure appartient.",
            "title": "Site Id",
            "type": "string"
          },
          "site_type": {
            "description": "Catégorie du site, dénormalisée depuis le site.",
            "title": "Site Type",
            "type": "string"
          },
          "temperature_celsius": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Température ambiante relevée en degrés Celsius.",
            "title": "Temperature Celsius"
          },
          "timestamp": {
            "description": "Horodatage de la mesure, ISO 8601 UTC.",
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "voltage_v": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Tension mesurée en volts.",
            "title": "Voltage V"
          }
        },
        "required": [
          "timestamp",
          "site_id",
          "site_type",
          "consumption_kw",
          "consumption_kwh",
          "voltage_v",
          "current_a",
          "power_factor",
          "temperature_celsius",
          "humidity_percent",
          "null_reasons",
          "data_quality",
          "consumption_kw_imputed",
          "imputation_method"
        ],
        "title": "EnergyReadingOut",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Corps de réponse commun à toutes les erreurs de l'API.",
        "properties": {
          "detail": {
            "description": "Message d'erreur destiné au consommateur de l'API.",
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthOut": {
        "description": "État de disponibilité de l'API.\n\nLe brief décrit un dict {status, timestamp} : il est typé ici pour\nrespecter la convention de projet (description sur chaque champ, valeurs\nfermées en Literal) et pour que le dashboard en dérive un type utilisable.",
        "properties": {
          "status": {
            "const": "ok",
            "description": "Statut de l'API, ok si elle répond.",
            "title": "Status",
            "type": "string"
          },
          "timestamp": {
            "description": "Horodatage de la réponse, ISO 8601 UTC.",
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          }
        },
        "required": [
          "status",
          "timestamp"
        ],
        "title": "HealthOut",
        "type": "object"
      },
      "PaginationMeta": {
        "description": "Métadonnées de pagination accompagnant toute collection paginée.",
        "properties": {
          "limit": {
            "description": "Taille de page demandée, entre 1 et 1000 (défaut 100).",
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "description": "Décalage appliqué au début de la collection.",
            "minimum": 0.0,
            "title": "Offset",
            "type": "integer"
          },
          "total": {
            "description": "Nombre total d'éléments disponibles pour la requête.",
            "minimum": 0.0,
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "total",
          "limit",
          "offset"
        ],
        "title": "PaginationMeta",
        "type": "object"
      },
      "PredictionOut": {
        "description": "Prévision complète renvoyée pour un site.",
        "properties": {
          "generated_at": {
            "description": "Horodatage de production de la prévision, ISO 8601 UTC.",
            "format": "date-time",
            "title": "Generated At",
            "type": "string"
          },
          "model_version": {
            "description": "Tag MLflow du modèle ayant servi la réponse.",
            "title": "Model Version",
            "type": "string"
          },
          "points": {
            "description": "Série prédite, triée par horodatage croissant.",
            "items": {
              "$ref": "#/components/schemas/PredictionPoint"
            },
            "title": "Points",
            "type": "array"
          },
          "site_id": {
            "description": "Identifiant du site prédit.",
            "title": "Site Id",
            "type": "string"
          }
        },
        "required": [
          "site_id",
          "model_version",
          "generated_at",
          "points"
        ],
        "title": "PredictionOut",
        "type": "object"
      },
      "PredictionPoint": {
        "description": "Point de la série prédite, avec son intervalle de confiance.",
        "properties": {
          "lower_bound_kw": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Borne basse de l'intervalle de confiance, nulle si non calculée.",
            "title": "Lower Bound Kw"
          },
          "predicted_consumption_kw": {
            "description": "Puissance prédite en kilowatts.",
            "title": "Predicted Consumption Kw",
            "type": "number"
          },
          "timestamp": {
            "description": "Horodatage du point prédit, ISO 8601 UTC.",
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "upper_bound_kw": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Borne haute de l'intervalle de confiance, nulle si non calculée.",
            "title": "Upper Bound Kw"
          }
        },
        "required": [
          "timestamp",
          "predicted_consumption_kw",
          "lower_bound_kw",
          "upper_bound_kw"
        ],
        "title": "PredictionPoint",
        "type": "object"
      },
      "PredictionRequest": {
        "description": "Demande de prévision de consommation pour un site.",
        "properties": {
          "horizon_hours": {
            "default": 24,
            "description": "Profondeur de la prévision en heures, entre 1 et 48.",
            "maximum": 48.0,
            "minimum": 1.0,
            "title": "Horizon Hours",
            "type": "integer"
          },
          "site_id": {
            "description": "Identifiant du site à prédire.",
            "title": "Site Id",
            "type": "string"
          }
        },
        "required": [
          "site_id"
        ],
        "title": "PredictionRequest",
        "type": "object"
      },
      "ReadingsPage": {
        "description": "Page de mesures énergétiques accompagnée de ses métadonnées.",
        "properties": {
          "items": {
            "description": "Mesures de la page, triées par horodatage croissant.",
            "items": {
              "$ref": "#/components/schemas/EnergyReadingOut"
            },
            "title": "Items",
            "type": "array"
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationMeta",
            "description": "Métadonnées de pagination de la requête."
          }
        },
        "required": [
          "items",
          "meta"
        ],
        "title": "ReadingsPage",
        "type": "object"
      },
      "SiteOut": {
        "description": "Site industriel supervisé, miroir du site de l'API Mock IoT.",
        "properties": {
          "capacity_kw": {
            "description": "Puissance souscrite du site en kilowatts.",
            "title": "Capacity Kw",
            "type": "number"
          },
          "location": {
            "description": "Localisation géographique du site.",
            "title": "Location",
            "type": "string"
          },
          "site_id": {
            "description": "Identifiant technique du site.",
            "title": "Site Id",
            "type": "string"
          },
          "site_name": {
            "description": "Libellé du site affiché dans le dashboard.",
            "title": "Site Name",
            "type": "string"
          },
          "site_type": {
            "description": "Catégorie de site, par exemple usine ou entrepôt.",
            "title": "Site Type",
            "type": "string"
          },
          "status": {
            "description": "État d'exploitation du site remonté par la source.",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "site_id",
          "site_type",
          "site_name",
          "location",
          "capacity_kw",
          "status"
        ],
        "title": "SiteOut",
        "type": "object"
      },
      "TokenResponse": {
        "description": "Jeton JWT délivré par le flux OAuth2 password.",
        "properties": {
          "access_token": {
            "description": "Jeton JWT à placer dans l'en-tête Authorization.",
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "description": "Durée de validité du jeton en secondes.",
            "exclusiveMinimum": 0.0,
            "title": "Expires In",
            "type": "integer"
          },
          "token_type": {
            "const": "bearer",
            "description": "Schéma d'authentification à utiliser, toujours bearer.",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "token_type",
          "expires_in"
        ],
        "title": "TokenResponse",
        "type": "object"
      },
      "UserOut": {
        "description": "Utilisateur authentifié tel qu'exposé par l'API.",
        "properties": {
          "role": {
            "description": "Rôle applicatif : reader en lecture seule, writer en écriture.",
            "enum": [
              "reader",
              "writer"
            ],
            "title": "Role",
            "type": "string"
          },
          "username": {
            "description": "Identifiant de connexion de l'utilisateur.",
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "role"
        ],
        "title": "UserOut",
        "type": "object"
      }
    },
    "securitySchemes": {
      "OAuth2PasswordBearer": {
        "flows": {
          "password": {
            "scopes": {},
            "tokenUrl": "/api/v1/auth/token"
          }
        },
        "type": "oauth2"
      }
    }
  },
  "info": {
    "description": "Contrat de l'API métier on-premise : sites, mesures énergétiques et alertes, servis sous JWT. Les endpoints non triviaux renvoient 501 tant que leur ticket d'implémentation n'est pas livré.",
    "title": "EnerVision API métier",
    "version": "1.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/alerts": {
      "get": {
        "operationId": "list_alerts_api_v1_alerts_get",
        "parameters": [
          {
            "description": "Restreindre aux alertes de ce site.",
            "in": "query",
            "name": "site_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Restreindre aux alertes de ce site.",
              "title": "Site Id"
            }
          },
          {
            "description": "Restreindre aux alertes de cette gravité.",
            "in": "query",
            "name": "severity",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "critical"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Restreindre aux alertes de cette gravité.",
              "title": "Severity"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AlertOut"
                  },
                  "title": "Response List Alerts Api V1 Alerts Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Jeton JWT absent, expiré ou invalide."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Paramètres de requête invalides."
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "Lister les alertes énergétiques",
        "tags": [
          "alerts"
        ]
      }
    },
    "/api/v1/auth/token": {
      "post": {
        "description": "Déclare le flux OAuth2 password dans la spécification.\n\nform_data porte le contrat d'entrée (username, password, scope) sans être\nexploité : la délivrance réelle du jeton est le périmètre d'EV-12.",
        "operationId": "create_token_api_v1_auth_token_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_create_token_api_v1_auth_token_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Identifiants invalides."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Paramètres de requête invalides."
          }
        },
        "summary": "Obtenir un jeton JWT (flux OAuth2 password)",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "Endpoint trivial, réellement implémenté : aucune dépendance externe.",
        "operationId": "get_health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Vérifier la disponibilité de l'API",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/predict": {
      "post": {
        "operationId": "create_prediction_api_v1_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Jeton JWT absent, expiré ou invalide."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Site inconnu."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Paramètres de requête invalides."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service d'inférence indisponible."
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "Obtenir la prévision de consommation d'un site",
        "tags": [
          "predictions"
        ]
      }
    },
    "/api/v1/sites": {
      "get": {
        "operationId": "list_sites_api_v1_sites_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SiteOut"
                  },
                  "title": "Response List Sites Api V1 Sites Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Jeton JWT absent, expiré ou invalide."
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "Lister les sites supervisés",
        "tags": [
          "sites"
        ]
      }
    },
    "/api/v1/sites/{site_id}": {
      "get": {
        "operationId": "get_site_api_v1_sites__site_id__get",
        "parameters": [
          {
            "description": "Identifiant du site.",
            "in": "path",
            "name": "site_id",
            "required": true,
            "schema": {
              "description": "Identifiant du site.",
              "title": "Site Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
